<diagram name="4. Оплата услуг (To-Be)" id="dfd4-to-be"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: защищённый контур. Вход только через IdM, доступ по RBAC и ABAC, каждое обращение пишется в аудит" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="620" as="geometry"/></mxCell><mxCell id="tb1" value="Платформа безопасности данных — общая для всех процессов" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1B7A3E;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#1B7A3E;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1300" height="150" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя сущность&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="250" height="80" as="geometry"/></mxCell><mxCell id="p41" value="&lt;b&gt;4.1 Расчёт стоимости&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;платёжный шлюз&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="p42" value="&lt;b&gt;4.2 Приём платежа&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;касса, ККМ, эквайринг&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fon