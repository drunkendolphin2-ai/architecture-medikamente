l><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ana" target="p53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="код обработки&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;доступ только к обезличенному слою&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p53" target="mart"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7l" value="агрегаты и признаки&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;тег K1, выгрузка разрешена&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="mart" target="mgmt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8l" value="P&amp;L, ABC-анализ,&lt;br&gt;загрузка специалистов&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;без персональных данных&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e8"><mxGeometry x="0.4" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lin" target="p51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9l" value="состав выгрузки" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat" target="p52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10l" value="правила по классам" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="raw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11l" value="контроль обращений" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="dq" target="anon"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12l" value="проверка остаточных ПДн" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что изменилось относительно As-Is&lt;/b&gt;&lt;br&gt;&lt;br&gt;Теневое хранилище исчезает: у аналитика&lt;br&gt;нет доступа к сырому слою.&lt;br&gt;&lt;br&gt;Между боевыми данными и аналитикой —&lt;br&gt;обязательный шаг обезличивания. Это и есть&lt;br&gt;аналитический слой Privacy by Design&lt;br&gt;из второго задания.&lt;br&gt;&lt;br&gt;Три зоны: сырая (закрыта), обезличенная&lt;br&gt;(аналитика), витрины (BI, ML, LLM).&lt;br&gt;&lt;br&gt;Контроль обезличивания — автопроверка,&lt;br&gt;что в K1 не просочились ПДн." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="1060" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="1072" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="1072" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_c" value="Средство защиты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="1072" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1114" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
