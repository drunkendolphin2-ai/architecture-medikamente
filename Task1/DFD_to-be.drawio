Geometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p22" target="p23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="заключение для пациента" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7l" value="заключение в PDF&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;шифрование на стороне хранилища&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23" target="pat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8l" value="доступ к своему заключению&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;TLS 1.3, проверка владения&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e8"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="idm" target="p22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9l" value="роль и лечащая связь" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kms" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10l" value="ключ медданных" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="d13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11l" value="разбор аномалий" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlp" target="p23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12l" value="контроль выгрузки" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что изменилось относительно As-Is&lt;/b&gt;&lt;br&gt;&lt;br&gt;Медкарта структурирована: можно выдать&lt;br&gt;назначения, не раскрывая анамнез.&lt;br&gt;&lt;br&gt;Доступ врача ограничен лечащей связью&lt;br&gt;(ABAC), а не ролью «врач». Это и закрывает&lt;br&gt;сценарий, когда учётка сотрудника&lt;br&gt;открывает картотеку целиком.&lt;br&gt;&lt;br&gt;Почта о пациенте заменена обсуждением&lt;br&gt;внутри МИС — контекст попадает в аудит.&lt;br&gt;&lt;br&gt;D13 — неизменяемый журнал доступа.&lt;br&gt;DLP перекрывает массовую выгрузку карт." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1060" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_c" value="Средство защиты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1034" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="3. Назначение и получение анализов (To-Be)" id="dfd3-to-be"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: защищённый контур. Вход только через IdM, доступ по RBAC и ABAC, каждое обращение пишется в аудит" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="620" as="geometry"/></mxCell><mxCell id="tb1" value="Платформа безопасности данных — общая для всех процессов" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1B7A3E;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#1B7A3E;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1300" height="150" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя сущность&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="80" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Лаборатория анализов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя организация&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="250" height="80" as="geometry"/></mxCell><mxCell id="p31" value="&lt;b&gt;3.1 Выписка направления&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;МИС&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fon