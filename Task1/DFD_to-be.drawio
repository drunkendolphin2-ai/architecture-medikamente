html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="idm" target="p43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9l" value="разделение ролей" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kms" target="d9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10l" value="ключи БД" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="d10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11l" value="неизменяемый лог" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="dlp" target="p43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12l" value="контроль выгрузки" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что изменилось относительно As-Is&lt;/b&gt;&lt;br&gt;&lt;br&gt;В чеке и у ОФД остаётся обобщённая&lt;br&gt;номенклатура «медицинская услуга».&lt;br&gt;Профиль обращения не покидает контур.&lt;br&gt;&lt;br&gt;Двойной учёт убран: один источник истины.&lt;br&gt;&lt;br&gt;Финансовый и медицинский контуры&lt;br&gt;разделены — бухгалтер не видит,&lt;br&gt;к какому врачу ходил пациент.&lt;br&gt;&lt;br&gt;Реквизиты карты в систему не попадают.&lt;br&gt;1С переведена в клиент-серверный режим." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1400" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1060" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_c" value="Средство защиты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1034" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="5. Отчётность и аналитика (To-Be)" id="dfd5-to-be"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: защищённый контур. Вход только через IdM, доступ по RBAC и ABAC, каждое обращение пишется в аудит" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="700" as="geometry"/></mxCell><mxCell id="tb1" value="Платформа безопасности данных — общая для всех процессов" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1B7A3E;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#1B7A3E;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1300" height="150" as="geometry"/></mxCell><mxCell id="mgmt" value="&lt;b&gt;Руководство&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;потребитель отчётов&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="250" height="80" as="geometry"/></mxCell><mxCell id="ana" value="&lt;b&gt;Бизнес-аналитик&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;доступ только к витринам&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="250" height="80" as="geometry"/></mxCell><mxCell id="p51" value="&lt;b&gt;5.1 Регламентный ETL&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;по расписанию, фиксированный состав полей&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="250" height="80" as="geometry"/></mxCell><mxCell id="p52" value="&lt;b&gt;5.2 Обезличивание&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;удаление и обобщение идентификаторов&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="p53" value="&lt;b&gt;5.3 Построение витрин&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;BI, ML, LLM&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;Источники: CRM, МИС, платежи&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;боевые БД, тег K2–K4&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="250" height="80" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;Сырой слой озера&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;изолирован, доступ только ETL&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="220" width="250" height="80" as="geometry"/></mxCell><mxCell id="anon" value="&lt;b&gt;Обезличенный слой&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;без ПДн, тег K1&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="mart" value="&lt;b&gt;Витрины отчётности&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;агрегаты для BI и ML&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="570" width="250" height="80" as="geometry"/></mxCell><mxCell id="lin" value="&lt;b&gt;Data Lineage&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;происхождение и состав полей&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="250" height="70" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b&gt;Каталог данных и теги&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;классы K1–K4, владельцы&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="390" y="890" width="250" height="70" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Аудит и SIEM&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;кто обращался к сырому слою&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="740" y="890" width="250" height="70" as="geometry"/></mxCell><mxCell id="dq" value="&lt;b&gt;Контроль обезличивания&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;проверка на остаточные ПДн&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1090" y="890" width="