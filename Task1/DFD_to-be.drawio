<diagram name="1. Запись на приём (To-Be)" id="dfd1-to-be"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: защищённый контур. Вход только через IdM, доступ по RBAC и ABAC, каждое обращение пишется в аудит" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="620" as="geometry"/></mxCell><mxCell id="tb1" value="Платформа безопасности данных — общая для всех процессов" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1B7A3E;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#1B7A3E;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1300" height="150" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;личный кабинет или ресепшен&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;1.1 Приём обращения&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;портал записи&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;1.2 Регистрация и согласие&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;CRM, электронная форма&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;D1 Записи на приём&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;PostgreSQL, TDE&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="250" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2 Расписание специалистов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;сервис расписаний&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="250" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;D4 Профиль пациента&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;CRM, шифрование полей&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;D3 Реестр согласий&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Consent Service&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="250" height="80" as="geometry"/></mxCell><mxCell id="idm" value="&lt;b&gt;IdM и каталог ролей&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Keycloak: RBAC, ABAC, SSO&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="kms" value="&lt;b&gt;Управление ключами&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;KMS или Vault, ротация&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="390" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Аудит и SIEM&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;журнал доступа, алерты&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="740" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="cns" value="&lt;b&gt;Учёт согласий&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;выдача, срок, отзыв&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1090" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0l" value="ФИО, телефон, услуга, время&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;TLS 1.3, вход по подтверждённому номеру&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e0"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=ortho