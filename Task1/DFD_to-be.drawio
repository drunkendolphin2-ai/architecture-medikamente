y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4l" value="id записи, время, кабинет&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;без ФИО: факт обращения не раскрывается&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5l" value="ФИО, дата рождения, контакты&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;AES-256 на уровне полей, тег K3&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="отметка о согласии и его версии&lt;div style=&quot;color:#1B7A3E&quot;&gt;&lt;b&gt;неизменяемый журнал, срок действия&lt;/b&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="idm" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7l" value="проверка прав" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="kms" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8l" value="ключи шифрования" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="aud" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9l" value="фиксация доступа" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;dashed=1;strokeColor=#9673A6;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="cns" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10l" value="жизненный цикл согласия" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e10"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что изменилось относительно As-Is&lt;/b&gt;&lt;br&gt;&lt;br&gt;Календарь не содержит ФИО — только&lt;br&gt;идентификатор записи: факт обращения&lt;br&gt;перестаёт утекать через Outlook.&lt;br&gt;&lt;br&gt;Хронические заболевания убраны&lt;br&gt;из анкеты ресепшена: их собирает&lt;br&gt;специалист на приёме.&lt;br&gt;&lt;br&gt;Профиль пациента один — удаление&lt;br&gt;по запросу выполняется в одном месте.&lt;br&gt;&lt;br&gt;Согласие стало объектом с версией,&lt;br&gt;сроком и отзывом вместо бумаги." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1060" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_c" value="Средство защиты" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="992" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1034" width="1020" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="2. Приём и ведение медкарты (To-Be)" id="dfd2-to-be"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: защищённый контур. Вход только через IdM, доступ по RBAC и ABAC, каждое обращение пишется в аудит" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="620" as="geometry"/></mxCell><mxCell id="tb1" value="Платформа безопасности данных — общая для всех процессов" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#1B7A3E;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#1B7A3E;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="770" width="1300" height="150" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя сущность&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="80" as="geometry"/></mxCell><mxCell id="doc" value="&lt;b&gt;Медицинский специалист&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;рабочее место в МИС&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="250" height="80" as="geometry"/></mxCell><mxCell id="p21" value="&lt;b&gt;2.1 Проведение приёма&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;МИС, карточка пациента&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="120" width="250" height="80" as="geometry"/></mxCell><mxCell id="p22" value="&lt;b&gt;2.2 Ведение медкарты&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;структурированный ввод&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="250" height="80" as="geometry"/></mxCell><mxCell id="p23" value="&lt;b&gt;2.3 Публикация пациенту&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;личный кабинет&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="510" width="250" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2 Расписание специалистов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;сервис расписаний&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="250" height="80" as="geometry"/></mxCell><mxCell id="d5" value="&lt;b&gt;D5 Медицинская карта&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;БД, шифрование полей, тег K4&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="200" width="250" height="80" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;D6 Вложения и заключения&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;объектное хранилище, SSE&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="350" width="250" height="80" as="geometry"/></mxCell><mxCell id="d13" value="&lt;b&gt;D13 Журнал доступа к карте&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;неизменяемый лог&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="250" height="80" as="geometry"/></mxCell><mxCell id="idm" value="&lt;b&gt;IdM и каталог ролей&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;роль «врач» + лечащая связь&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="kms" value="&lt;b&gt;Управление ключами&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;отдельный ключ на медданные&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="390" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="aud" value="&lt;b&gt;Аудит и SIEM&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;алерт на нетипичный доступ&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="740" y="820" width="250" height="70" as="geometry"/></mxCell><mxCell id="dlp" value="&lt;b&gt;DLP на каналах&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;блокировка выгрузки карт&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;verticalAlign=middle;dashed=0;" vertex="1" parent="1"><mxGeometry x="1090" y="820" width="250" height="70" a