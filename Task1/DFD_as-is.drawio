"p23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="карта на оцифровку" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p23" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7l" value="скан карты целиком,&lt;br&gt;без разделения по чувствительности" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что здесь не защищено&lt;/b&gt;&lt;br&gt;&lt;br&gt;Медкарта — спецкатегория ПДн&lt;br&gt;и врачебная тайна. Без шифрования&lt;br&gt;и без аудита доступа.&lt;br&gt;&lt;br&gt;Скан неделим: прочитать «только&lt;br&gt;назначения» нельзя, открывается всё.&lt;br&gt;&lt;br&gt;Почта о пациенте — канал вне учёта:&lt;br&gt;копии в «Отправленных» и в локальных&lt;br&gt;OST на рабочих станциях.&lt;br&gt;&lt;br&gt;Срок хранения карты — 25 лет,&lt;br&gt;порядок уничтожения не определён." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="800" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="752" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="752" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="752" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="794" width="760" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram name="3. Назначение и получение анализов (As-Is)" id="dfd3-as-is"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: ЛВС офиса. Вход — доменная учётная запись, разграничения внутри нет, аудит доступа не ведётся" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="600" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя сущность&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="250" height="80" as="geometry"/></mxCell><mxCell id="lab" value="&lt;b&gt;Лаборатория анализов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя организация&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="250" height="80" as="geometry"/></mxCell><mxCell id="p31" value="&lt;b&gt;3.1 Выписка направления&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;специалист, бланк&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="p32" value="&lt;b&gt;3.2 Отправка заявки&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;ресепшен, электронная почта&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="310" width="250" height="80" as="geometry"/></mxCell><mxCell id="p33" value="&lt;b&gt;3.3 Приём результата&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;ресепшен, электронная почта&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="490" width="250" height="80" as="geometry"/></mxCell><mxCell id="d8" value="&lt;b&gt;D8 Журнал анализов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Excel, общий диск&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="250" height="80" as="geometry"/></mxCell><mxCell id="d7" value="&lt;b&gt;D7 Почтовая переписка&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Exchange, вложения с результатами&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="240" width="250" height="80" as="geometry"/></mxCell><mxCell id="d6" value="&lt;b&gt;D6 Сканы результатов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;PDF, общий диск&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="440" width="250" height="80" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0l" value="согласие на исследование" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e0"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31" target="d8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1l" value="ФИО, дата рождения,&lt;br&gt;перечень исследований" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p31" target="p32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2l" value="направление" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p32" target="lab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3l" value="ФИО, дата рождения, полис,&lt;br&gt;перечень исследований" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p32" target="d7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4l" value="копия заявки в «Отправленных»" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lab" target="p33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5l" value="результаты с показателями&lt;br&gt;и референсными значениями" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="скан результата" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p33" target="pat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7l" value="результат по электронной почте&lt;br&gt;или на бумаге" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что здесь не защищено&lt;/b&gt;&lt;br&gt;&lt;br&gt;Данные покидают контур: передача&lt;br&gt;в лабораторию обычной почтой,&lt;br&gt;без шифрования и без учёта объёма.&lt;br&gt;&lt;br&gt;Лаборатория — отдельный оператор ПДн.&lt;br&gt;Поручение по ст. 6 152-ФЗ&lt;br&gt;не оформлено.&lt;br&gt;&lt;br&gt;Избыточность: для исследования&lt;br&gt;достаточно номера направления,&lt;br&gt;ФИО не нужны.&lt;br&gt;&lt;br&gt;Вложения остаются в ящиках навсегда." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="800" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="732" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=