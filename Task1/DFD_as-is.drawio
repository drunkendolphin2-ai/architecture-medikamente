<diagram name="1. Запись на приём (As-Is)" id="dfd1-as-is"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tb0" value="Граница доверия: ЛВС офиса. Вход — доменная учётная запись, разграничения внутри нет, аудит доступа не ведётся" style="rounded=1;arcSize=4;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#B85450;strokeWidth=1.5;verticalAlign=top;align=left;spacing=10;fontSize=12;fontColor=#B85450;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="20" width="640" height="600" as="geometry"/></mxCell><mxCell id="pat" value="&lt;b&gt;Пациент&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;внешняя сущность&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="p11" value="&lt;b&gt;1.1 Приём обращения&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;ресепшен, по телефону или очно&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;1.2 Регистрация и договор&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;ресепшен, вручную&lt;/div&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;D1 Журнал записи&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Excel, общий диск&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="50" width="250" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;D2 Календарь специалиста&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Exchange / Outlook&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="190" width="250" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;D4 Картотека пациентов&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;Excel, общий диск&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="250" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;D3 Договоры и согласия&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;бумага и сканы PDF&lt;/div&gt;" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="470" width="250" height="80" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e0l" value="ФИО, телефон,&lt;br&gt;желаемая услуга и время" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e0"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1l" value="паспорт, дата рождения, адрес,&lt;br&gt;место работы, хронические заболевания" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2l" value="сверка: пациент уже заведён?" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.2" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3l" value="ФИО, телефон, время,&lt;br&gt;специалист, услуга" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4l" value="ФИО пациента, время, кабинет" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5l" value="ФИО, дата рождения, контакты,&lt;br&gt;адрес, место работы" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6l" value="договор, согласие на обработку ПДн,&lt;br&gt;информированное добровольное согласие" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="nt0" value="&lt;b&gt;Что здесь не защищено&lt;/b&gt;&lt;br&gt;&lt;br&gt;Факт обращения — врачебная тайна&lt;br&gt;(ст. 13 323-ФЗ), но D1 и D2 защищены&lt;br&gt;как обычные файлы.&lt;br&gt;&lt;br&gt;Данные расходятся по четырём&lt;br&gt;хранилищам: единого источника&lt;br&gt;и согласованного удаления нет.&lt;br&gt;&lt;br&gt;Хронические заболевания —&lt;br&gt;спецкатегория ПДн — в том же Excel,&lt;br&gt;что и телефон.&lt;br&gt;&lt;br&gt;Аудита доступа нет. Согласия&lt;br&gt;на бумаге, без реестра и отзыва." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1060" y="50" width="340" height="300" as="geometry"/></mxCell><mxCell id="lgbox" value="&lt;b&gt;Нотация&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="800" height="110" as="geometry"/></mxCell><mxCell id="lg_ee" value="Внешняя сущность" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="732" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_p" value="Процесс" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="732" width="230" height="36" as="geometry"/></mxCell><mxCell id="lg_s" value="Хранилище данных" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=1;bottom=1;left=0;right=0;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=13;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="732" width="230" height="36" as="geometry"/></mxCell><mxCell id="lgtb" value="Пунктирная рамка — граница доверия. Зелёным на связях — применяемая мера защиты." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="774" width="760" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram>
