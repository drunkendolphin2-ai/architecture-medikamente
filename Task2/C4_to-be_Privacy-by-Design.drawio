<mxfile host="app.diagrams.net" agent="Claude" version="24.8.4">
<diagram name="C4 L1. Контекст целевого состояния (MVP)" id="c4-context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pat" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Пациент&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Записывается на приём, видит свои заключения и результаты анализов&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#6C6477;strokeColor=#4D4D4D;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="220" height="170" as="geometry"/></mxCell><mxCell id="sys" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Медицинская платформа «Медикаменте»&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Единая система записи, ведения медицинских карт, оплаты и аналитики. Конфиденциальность данных обеспечивается по умолчанию&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="340" height="230" as="geometry"/></mxCell><mxCell id="rec" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Сотрудник ресепшена&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Ведёт расписание, подтверждает записи, напоминает о приёме&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="60" width="220" height="170" as="geometry"/></mxCell><mxCell id="doc" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Медицинский специалист&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Ведёт медицинские карты закреплённых за ним пациентов&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="265" width="220" height="170" as="geometry"/></mxCell><mxCell id="fin" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Кассир и бухгалтерия&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Принимают платежи и ведут учёт без доступа к медицинским данным&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="470" width="220" height="170" as="geometry"/></mxCell><mxCell id="ana" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Бизнес-аналитик&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Строит отчётность и модели только на обезличенных данных&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="675" width="220" height="170" as="geometry"/></mxCell><mxCell id="sec" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Офицер информационной безопасности&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Новая роль: управляет политиками доступа, разбирает инциденты&lt;/div&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="1240" y="880" width="220" height="170" as="geometry"/></mxCell><mxCell id="lab" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Лаборатория анализов&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Выполняет исследования. Получает обезличенное направление по токену&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="240" height="130" as="geometry"/></mxCell><mxCell id="bank" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Банк-эквайрер&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Проводит оплату. Реквизиты карты в платформу не попадают&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="320" y="690" width="240" height="130" as="geometry"/></mxCell><mxCell id="ofd" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Оператор фискальных данных&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Получает чек с обобщённой номенклатурой «медицинская услуга»&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="600" y="690" width="240" height="130" as="geometry"/></mxCell><mxCell id="notif" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Сервис уведомлений&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;SMS и push-напоминания без медицинских деталей&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="880" y="690" width="240" height="130" as="geometry"/></mxCell><mxCell id="buh" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;1С:Бухгалтерия предприятия&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Остаётся. Получает проводки без сведений о составе услуги&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="240" height="130" as="geometry"/></mxCell><mxCell id="wms" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;1С:Торговля и склад&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Остаётся. Персональные данные пациентов не обрабатывает&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="320" y="880" width="240" height="130" as="geometry"/></mxCell><mxCell id="esia" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Провайдер идентификации (ЕСИА)&lt;/b&gt;&lt;/font&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px;color:#cccccc&quot;&gt;Подтверждение личности пациента при входе в личный кабинет&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1"><mxGeometry x="600" y="880" width="240" height="130" as="geometry"/></mxCell><mxCell id="r0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pat" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0l" value="Записывается на приём,&lt;br&gt;смотрит свои данные&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS, мобильное приложение]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r0"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1l" value="Ведёт расписание,&lt;br&gt;подтверждает записи&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="doc" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2l" value="Ведёт медицинские карты&lt;br&gt;своих пациентов&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r2"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="fin" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3l" value="Принимает платежи,&lt;br&gt;ведёт учёт&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r3"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="ana" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4l" value="Строит отчёты&lt;br&gt;на обезличенных данных&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r4"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec" target="sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5l" value="Управляет политиками,&lt;br&gt;разбирает инциденты&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r5"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="lab"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6l" value="Направление по токену:&lt;br&gt;без ФИО&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[mTLS, REST]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r6"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="bank"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7l" value="Авторизация платежа&lt;br&gt;по токену карты&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[TLS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r7"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="ofd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r8l" value="Фискальные данные&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[TLS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r8"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r9l" value="Напоминание о приёме&lt;br&gt;без медицинских деталей&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[TLS]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="buh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r10l" value="Проводки без сведений&lt;br&gt;о составе услуги&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[REST]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r10"><mxGeometry x="-0.3" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wms" target="buh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r11l" value="Учёт ТМЦ&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[OLE]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r11"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#666666;fontSize=11;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="esia"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r12l" value="Подтверждение личности&lt;div style=&quot;font-size:10px;color:#777777&quot;&gt;[OIDC]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;fontSize=11;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r12"><mxGeometry x="0.3" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="cn0" value="&lt;b&gt;Что изменилось&lt;/b&gt;&lt;br&gt;&lt;br&gt;Лаборатория не получает ФИО — только токен.&lt;br&gt;ОФД получает обобщённую номенклатуру услуги.&lt;br&gt;1С получает проводку без состава услуги.&lt;br&gt;Реквизиты карты в платформу не попадают.&lt;br&gt;Добавлена роль офицера ИБ." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EDE7F6;strokeColor=#6B4FA8;align=left;verticalAlign=top;spacing=10;fontSize=11;size=18;" vertex="1" parent="1"><mxGeometry x="1500" y="60" width="360" height="170" as="geometry"/></mxCell><mxCell id="lgb" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#AAAAAA;verticalAlign=top;align=left;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1120" width="1000" height="90" as="geometry"/></mxCell><mxCell id="lgp" value="Роль" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;align=center;metaEdit=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1152" width="220" height="40" as="geometry"/></mxCell><mxCell id="lgs" value="Система" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1061B0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0D5091;metaEdit=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="1152" width="220" height="40" as="geometry"/></mxCell><mxCell id="lgc" value="Существующий контейнер" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="1152" width="220" height="40" as="geometry"/></mxCell><mxCell id="lgn" value="Новый блок Privacy by Design" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#6B4FA8;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#4A3578;strokeWidth=2;metaEdit=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1152" width="220" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
